<Window x:Class="MvvmDataBinding.OneWayBinding"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:se="clr-namespace:SpiceLogic.HtmlEditor.WPF;assembly=SpiceLogic.HtmlEditor.WPF"
        Title="OneWay binding" Height="480" Width="1000" Loaded="OneWayBinding_OnLoaded">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="2*"/>
        </Grid.RowDefinitions>

        <!-- Description -->
        <Border Background="#F0F6FF" BorderBrush="#B0C4DE" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
            <TextBlock TextWrapping="Wrap" Foreground="#333" LineHeight="22">
                <Bold>OneWay binding:</Bold> the editor's BodyHtml is bound <Bold>OneWay</Bold> to the view model.
                Changes typed into the text box above push into the view model, which then flows into the editor.
                Edits made directly in the editor do <Bold>not</Bold> flow back, because the binding has only one
                direction.
            </TextBlock>
        </Border>

        <TextBox Grid.Row="1" Text="{Binding BodyHtml, UpdateSourceTrigger=PropertyChanged}"/>
        <se:WpfHtmlEditor Grid.Row="2" BodyHtml="{Binding BodyHtml, Mode=OneWay}"/>
    </Grid>
</Window>
