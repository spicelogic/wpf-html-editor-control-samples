<Window x:Class="MvvmDataBinding.TwoWayLostFocusBinding"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:se="clr-namespace:SpiceLogic.HtmlEditor.WPF;assembly=SpiceLogic.HtmlEditor.WPF"
        Title="TwoWay binding - LostFocus trigger" Height="460" Width="860" Loaded="TwoWayLostFocusBinding_OnLoaded">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!--
            UpdateSourceTrigger=Default resolves to LostFocus for BodyHtml - the editor's own default,
            and it is intentional: switching it to PropertyChanged pushes the view model setter on
            every keystroke, paste and toolbar action, which thrashes the garbage collector and can
            make a change handler fight the caret. LostFocus writes one snapshot per editing session
            instead.

            The trade-off: while focus stays inside the editor, the view model can be behind the last
            few edits. Try it - type below, then click "Show BodyHtml of view model" WITHOUT tabbing
            out of the editor first; the message box shows the stale value. Tab out (or click the text
            box) and try again, and it is current. To read the latest value on demand without waiting
            for a focus change, call editor.UpdateBindings() first - see the TwoWay, Explicit trigger
            scenario for that pattern, which is the single most common support question about this
            control.
        -->
        <Border Grid.Row="0" Background="#F0F6FF" BorderBrush="#B0C4DE" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
            <TextBlock TextWrapping="Wrap" Foreground="#333" LineHeight="22">
                <Bold>TwoWay, LostFocus trigger:</Bold> the editor's BodyHtml uses its default UpdateSourceTrigger,
                which is <Bold>LostFocus</Bold>. The view model updates only when the editor loses focus, for
                example by tabbing to the text box below. This is the recommended default for most applications.
            </TextBlock>
        </Border>

        <Label Grid.Row="1">Editor (UpdateSourceTrigger = Default, which is LostFocus)</Label>
        <se:WpfHtmlEditor Grid.Row="2" BodyHtml="{Binding BodyHtml, UpdateSourceTrigger=Default}"/>
        <Label Grid.Row="3">Text box (UpdateSourceTrigger = PropertyChanged)</Label>
        <TextBox Grid.Row="4" Text="{Binding BodyHtml, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap"/>
        <Button x:Name="ShowBodyHtmlButton" Grid.Row="5" Width="240" HorizontalAlignment="Left" Margin="0,10,0,0"
                Click="ShowBodyHtmlButton_OnClick">Show BodyHtml of view model</Button>
    </Grid>
</Window>
