<Window x:Class="MvvmDataBinding.TwoWayPropertyChangedBinding"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:se="clr-namespace:SpiceLogic.HtmlEditor.WPF;assembly=SpiceLogic.HtmlEditor.WPF"
        Title="TwoWay binding - PropertyChanged trigger" Height="500" Width="1000" Loaded="TwoWayPropertyChangedBinding_OnLoaded">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Description -->
        <Border Grid.Row="0" Background="#F0F6FF" BorderBrush="#B0C4DE" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
            <TextBlock TextWrapping="Wrap" Foreground="#333" LineHeight="22">
                <Bold>TwoWay, PropertyChanged trigger:</Bold> both the editor and the text box use
                <Bold>UpdateSourceTrigger=PropertyChanged</Bold>, so changes flow in both directions on every
                keystroke. Useful for a live preview, but see the LostFocus scenario for why this is not the
                editor's own default: pushing the view model setter on every keystroke, paste and toolbar action
                is measurably more expensive on a large document.
            </TextBlock>
        </Border>

        <Label Grid.Row="1">Editor (UpdateSourceTrigger = PropertyChanged)</Label>
        <se:WpfHtmlEditor Grid.Row="2" BodyHtml="{Binding BodyHtml, UpdateSourceTrigger=PropertyChanged}"/>
        <Label Grid.Row="3">Text box (UpdateSourceTrigger = PropertyChanged)</Label>
        <TextBox Grid.Row="4" Text="{Binding BodyHtml, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap"/>
        <Button x:Name="ShowBodyHtmlButton" Grid.Row="5" Width="240" HorizontalAlignment="Left" Margin="0,10,0,0"
                Click="ShowBodyHtmlButton_OnClick">Show BodyHtml of view model</Button>
    </Grid>
</Window>
