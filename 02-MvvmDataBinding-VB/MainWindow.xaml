<Window x:Class="MvvmDataBinding.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WPF HTML editor control - MVVM data binding" Height="580" Width="660"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Overview -->
        <Border Grid.Row="0" Background="#F0F6FF" BorderBrush="#B0C4DE" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,15">
            <StackPanel>
                <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="#1A3A5C" Text="What this sample shows" Margin="0,0,0,6"/>
                <TextBlock TextWrapping="Wrap" Foreground="#333" LineHeight="22">
                    <Bold>BodyHtml</Bold> is a full WPF dependency property, so it supports every standard binding
                    mode - OneWay, TwoWay, and each UpdateSourceTrigger option. Each scenario below opens a small,
                    focused window; edit the HTML and watch how the view model and the editor stay, or do not
                    stay, in sync.
                </TextBlock>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="1" Text="Choose a binding scenario:" FontWeight="SemiBold" Margin="2,0,0,8"/>

        <StackPanel Grid.Row="2">
            <Button x:Name="OneWayButton" Padding="10,8" HorizontalContentAlignment="Left"
                    Click="OneWayButton_OnClick" Content="OneWay binding - view model to editor"/>
            <Button x:Name="TwoWayLostFocusButton" Padding="10,8" Margin="0,6,0,0" HorizontalContentAlignment="Left"
                    Click="TwoWayLostFocusButton_OnClick" Content="TwoWay, LostFocus trigger - the editor's default"/>
            <Button x:Name="TwoWayExplicitButton" Padding="10,8" Margin="0,6,0,0" HorizontalContentAlignment="Left"
                    Click="TwoWayExplicitButton_OnClick" Content="TwoWay, Explicit trigger - UpdateBindings() on demand"/>
            <Button x:Name="TwoWayPropertyChangedButton" Padding="10,8" Margin="0,6,0,0" HorizontalContentAlignment="Left"
                    Click="TwoWayPropertyButton_OnClick" Content="TwoWay, PropertyChanged trigger - live sync"/>
            <Button x:Name="ElementBindingButton" Padding="10,8" Margin="0,6,0,0" HorizontalContentAlignment="Left"
                    Click="ElementBindingButton_OnClick" Content="Element binding - the editor as its own binding source"/>
        </StackPanel>
    </Grid>
</Window>
