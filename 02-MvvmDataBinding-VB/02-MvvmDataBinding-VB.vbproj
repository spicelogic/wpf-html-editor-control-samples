<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- RootNamespace intentionally empty: VB's WPF code-gen wraps generated
         partials in the namespace named by each x:Class attribute; user code in
         this folder uses matching "Namespace Global.MvvmDataBinding" blocks so
         the partial classes merge cleanly. -->
    <RootNamespace></RootNamespace>
    <StartupObject>MvvmDataBinding.Program</StartupObject>
  </PropertyGroup>

  <!-- App.xaml is treated as Page (not ApplicationDefinition) to sidestep
       PresentationBuildTasks' BC30149 / BC30420 bug with VB Application classes
       in SDK-style projects. The Application is bootstrapped from a manual Sub
       Main in App.xaml.vb instead. -->
  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SpiceLogic.HtmlEditor.WPF" Version="*" />
  </ItemGroup>

</Project>
