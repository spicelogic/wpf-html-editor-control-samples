<Window x:Class="MvvmDataBinding.TwoWayExplicitBinding"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:se="clr-namespace:SpiceLogic.HtmlEditor.WPF;assembly=SpiceLogic.HtmlEditor.WPF"
        xmlns:viewModel="clr-namespace:MvvmDataBinding.ViewModel"
        Title="TwoWay binding - Explicit trigger" Height="560" Width="920">
    <Window.DataContext>
        <viewModel:EmailViewModel/>
    </Window.DataContext>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Description -->
        <Border Grid.Row="0" Background="#F0F6FF" BorderBrush="#B0C4DE" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
            <TextBlock TextWrapping="Wrap" Foreground="#333" LineHeight="22">
                <Bold>TwoWay, Explicit trigger:</Bold> an email compose window, where the body uses
                <Bold>UpdateSourceTrigger=Explicit</Bold>. The view model is updated only when code calls
                <Bold>editor.UpdateBindings()</Bold> - both buttons below do this before reading the body. This is
                the pattern to reach for any time the editor's latest content is needed on demand, regardless of
                which UpdateSourceTrigger the binding actually uses.
            </TextBlock>
        </Border>

        <Label Grid.Row="1">Subject (UpdateSourceTrigger = PropertyChanged)</Label>
        <TextBox Grid.Row="2" Text="{Binding Subject, UpdateSourceTrigger=PropertyChanged}"/>
        <Label Grid.Row="3">Body (UpdateSourceTrigger = Explicit)</Label>
        <se:WpfHtmlEditor x:Name="Editor" Grid.Row="4" BodyHtml="{Binding Body, UpdateSourceTrigger=Explicit}"/>
        <DockPanel Grid.Row="5" LastChildFill="False" HorizontalAlignment="Left" Margin="0,10,0,0">
            <Button Padding="8,4" Click="InsertGreetingButton_OnClick">Insert greeting</Button>
            <Button Padding="8,4" Click="GetEmailButton_OnClick" Margin="10,0,0,0">Get email body (calls UpdateBindings())</Button>
        </DockPanel>
        <Label Grid.Row="6">Subject (read only)</Label>
        <TextBox Grid.Row="7" Text="{Binding Subject}" IsReadOnly="True" Background="LightGray"/>
        <Label Grid.Row="8">Email body (UpdateSourceTrigger = PropertyChanged), shown for comparison only</Label>
        <TextBox Grid.Row="9" Text="{Binding Body, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap"/>
    </Grid>
</Window>
