<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- RootNamespace intentionally empty: VB's WPF code-gen wraps generated
         partials in Namespace CustomSpellChecker; user code in this folder
         uses Namespace Global.CustomSpellChecker (the x:Class attributes are
         copied verbatim from the generated partials) so they merge cleanly. -->
    <RootNamespace></RootNamespace>
    <StartupObject>CustomSpellChecker.Program</StartupObject>
  </PropertyGroup>

  <!-- App.xaml is treated as Page (not ApplicationDefinition) to sidestep
       PresentationBuildTasks' BC30149 / BC30420 bug with VB Application classes
       in SDK-style projects. The Application is bootstrapped from a manual Sub
       Main in App.xaml.vb instead. -->
  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="underline.gif" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="underline.gif">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SpiceLogic.HtmlEditor.WPF" Version="*" />
  </ItemGroup>

</Project>
