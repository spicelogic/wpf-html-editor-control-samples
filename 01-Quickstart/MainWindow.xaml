<Window x:Class="Quickstart.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:se="clr-namespace:SpiceLogic.HtmlEditor.WPF;assembly=SpiceLogic.HtmlEditor.WPF"
        Title="WPF HTML editor control - quickstart" Height="650" Width="950">
    <DockPanel>
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="CharacterCountText" Text="0 characters" />
            </StatusBarItem>
        </StatusBar>
        <se:WpfHtmlEditor x:Name="Editor" HtmlChanged="Editor_HtmlChanged" />
    </DockPanel>
</Window>
