<Window x:Class="FullEditorDemoVB.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:se="clr-namespace:SpiceLogic.HtmlEditor.WPF;assembly=SpiceLogic.HtmlEditor.WPF"
        xmlns:userOptions="clr-namespace:SpiceLogic.HtmlEditor.WPF.Models.BOs.UserOptions;assembly=SpiceLogic.HtmlEditor.WPF"
        xmlns:designTime="clr-namespace:SpiceLogic.HtmlEditor.Abstractions.DesignTime;assembly=SpiceLogic.HtmlEditor.Abstractions"
        Title="WPF HTML editor control - full editor demo (VB.NET)" Height="700" Width="1050">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="15,12,15,6">
            <TextBlock Text="Spell check language:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox x:Name="LanguageComboBox" Width="220" SelectionChanged="LanguageComboBox_SelectionChanged"/>
        </StackPanel>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="CharacterCountText" Text="0 characters" />
            </StatusBarItem>
        </StatusBar>

        <se:WpfHtmlEditor x:Name="Editor" Margin="15,0,15,15" HtmlChanged="Editor_HtmlChanged">
            <se:WpfHtmlEditor.SpellCheckOptions>
                <userOptions:SpellCheckerOption FireInlineSpellCheckingOnKeyStroke="True">
                    <userOptions:SpellCheckerOption.DictionaryFile>
                        <designTime:DictionaryFileInfo/>
                    </userOptions:SpellCheckerOption.DictionaryFile>
                </userOptions:SpellCheckerOption>
            </se:WpfHtmlEditor.SpellCheckOptions>
        </se:WpfHtmlEditor>
    </DockPanel>
</Window>
