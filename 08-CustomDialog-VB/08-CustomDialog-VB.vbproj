<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Left blank on purpose: every code file declares its namespace explicitly as
         "Namespace Global.CustomDialog...", and VB prepends RootNamespace to the plain
         (non-Global-qualified) namespace that the XAML compiler generates for code-behind.
         A non-empty RootNamespace here would make the two partial-class halves land in two
         different namespaces and fail to merge. -->
    <RootNamespace></RootNamespace>
    <OptionExplicit>On</OptionExplicit>
    <OptionStrict>On</OptionStrict>
    <OptionInfer>On</OptionInfer>
    <StartupObject>CustomDialog.Program</StartupObject>
  </PropertyGroup>

  <!-- App.xaml carries no x:Class and is compiled as a Page rather than an
       ApplicationDefinition, to sidestep a PresentationBuildTasks codegen bug (BC30149 /
       BC30420) with VB classes deriving from System.Windows.Application. The Application is
       bootstrapped from the manual Sub Main in App.xaml.vb instead. Every VB WPF sample in
       this repository uses the same pattern. -->
  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SpiceLogic.HtmlEditor.WPF" Version="*" />
  </ItemGroup>

</Project>
