<UserControl x:Class="CustomDialog.Dialogs.StyleBuilder.ucLayout"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="490" d:DesignWidth="472"
             Loaded="ucLayout_Loaded">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SpiceLogic.HtmlEditor.WPF;component/Themes/Generic.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel Margin="20,10,10,10">
        <TextBlock FontWeight="Bold" Text="Visibility" />
        <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition Height="10" />
                <RowDefinition />
                <RowDefinition Height="10" />
                <RowDefinition />
                <RowDefinition Height="10" />
                <RowDefinition />
            </Grid.RowDefinitions>
            <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center" Style="{DynamicResource ThinTextBlockStyle}" Text="Visibility" TextWrapping="Wrap" />
            <ComboBox x:Name="CbVisibility" Grid.Row="0" Grid.Column="2" Margin="0,-0.001,0,0" />
            <TextBlock Grid.Row="2" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" Style="{DynamicResource ThinTextBlockStyle}" Text="Display" TextWrapping="Wrap" />
            <ComboBox x:Name="CbDisplay" Grid.Row="2" Grid.Column="2" />
            <TextBlock Grid.Row="4" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5" Style="{DynamicResource ThinTextBlockStyle}" Text="Allow text to flow" TextWrapping="Wrap" />
            <ComboBox x:Name="CbAllowTextToFlow" Grid.Row="4" Grid.Column="2" RenderTransformOrigin="0.5,0.5" />
            <TextBlock Grid.Row="6" Grid.Column="0" Margin="0,7.876" HorizontalAlignment="Left" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5" Style="{DynamicResource ThinTextBlockStyle}" Text="Allow floating objects" TextWrapping="Wrap" />
            <ComboBox x:Name="CbAllowFloatingObject" Grid.Row="6" Grid.Column="2" RenderTransformOrigin="0.5,0.5" />
        </Grid>
        <Border Height="1" Margin="0,10" Background="{DynamicResource PropertyBlockSeparatorBrush}" />
        <TextBlock FontWeight="Bold" Text="Content" />
        <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center" Style="{DynamicResource ThinTextBlockStyle}" Text="Overflow" TextWrapping="Wrap" />
            <ComboBox x:Name="CbOverflow" Grid.Column="2" Margin="0,-0.001,0,0" />
        </Grid>
        <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="35" />
                <RowDefinition Height="10" />
                <RowDefinition />
            </Grid.RowDefinitions>
            <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center" Style="{DynamicResource ThinTextBlockStyle}" Text="Top" />
            <Grid Grid.Row="0" Grid.Column="1" Margin="10,0,5,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="5" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TbTop" Grid.Column="0" Margin="0,0,5,0" />
                <ComboBox x:Name="CbTopType" Grid.Row="0" Grid.Column="2" >
                    <ComboBoxItem>px</ComboBoxItem>
                    <ComboBoxItem>%</ComboBoxItem>
                    <ComboBoxItem>pt</ComboBoxItem>
                    <ComboBoxItem>pc</ComboBoxItem>
                    <ComboBoxItem>mm</ComboBoxItem>
                    <ComboBoxItem>cm</ComboBoxItem>
                    <ComboBoxItem>in</ComboBoxItem>
                    <ComboBoxItem>em</ComboBoxItem>
                    <ComboBoxItem>ex</ComboBoxItem>
                </ComboBox>
            </Grid>
            <TextBlock Grid.Row="0" Grid.Column="2" Margin="10,0" HorizontalAlignment="Left" VerticalAlignment="Center" Style="{DynamicResource ThinTextBlockStyle}" Text="Bottom" TextWrapping="Wrap" />
            <Grid Grid.Row="0" Grid.Column="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="5" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TbBottom" Grid.Column="0" Margin="5,0" />
                <ComboBox x:Name="CbBottomType" Grid.Row="0" Grid.Column="2">
                    <ComboBoxItem>px</ComboBoxItem>
                    <ComboBoxItem>%</ComboBoxItem>
                    <ComboBoxItem>pt</ComboBoxItem>
                    <ComboBoxItem>pc</ComboBoxItem>
                    <ComboBoxItem>mm</ComboBoxItem>
                    <ComboBoxItem>cm</ComboBoxItem>
                    <ComboBoxItem>in</ComboBoxItem>
                    <ComboBoxItem>em</ComboBoxItem>
                    <ComboBoxItem>ex</ComboBoxItem>
                </ComboBox>
            </Grid>
            <TextBlock Grid.Row="2" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" Style="{DynamicResource ThinTextBlockStyle}" Text="Left" />
            <Grid Grid.Row="2" Grid.Column="1" Margin="10,0,5,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="5" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TbLeft" Grid.Column="0" Margin="0,0,5,0" />
                <ComboBox x:Name="CbLeftType" Grid.Row="0" Grid.Column="2">
                    <ComboBoxItem>px</ComboBoxItem>
                    <ComboBoxItem>%</ComboBoxItem>
                    <ComboBoxItem>pt</ComboBoxItem>
                    <ComboBoxItem>pc</ComboBoxItem>
                    <ComboBoxItem>mm</ComboBoxItem>
                    <ComboBoxItem>cm</ComboBoxItem>
                    <ComboBoxItem>in</ComboBoxItem>
                    <ComboBoxItem>em</ComboBoxItem>
                    <ComboBoxItem>ex</ComboBoxItem>
                </ComboBox>
            </Grid>
            <TextBlock Grid.Row="2" Grid.Column="2" Margin="10,0" HorizontalAlignment="Left" VerticalAlignment="Center" Style="{DynamicResource ThinTextBlockStyle}" Text="Right" TextWrapping="Wrap" />
            <Grid Grid.Row="2" Grid.Column="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="5" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TbRight" Grid.Column="0" Margin="5,0" />
                <ComboBox x:Name="CbRightType" Grid.Row="0" Grid.Column="2">
                    <ComboBoxItem>px</ComboBoxItem>
                    <ComboBoxItem>%</ComboBoxItem>
                    <ComboBoxItem>pt</ComboBoxItem>
                    <ComboBoxItem>pc</ComboBoxItem>
                    <ComboBoxItem>mm</ComboBoxItem>
                    <ComboBoxItem>cm</ComboBoxItem>
                    <ComboBoxItem>in</ComboBoxItem>
                    <ComboBoxItem>em</ComboBoxItem>
                    <ComboBoxItem>ex</ComboBoxItem>
                </ComboBox>
            </Grid>
        </Grid>
        <Border Height="1" Margin="0,10" Background="{DynamicResource PropertyBlockSeparatorBrush}" />
        <TextBlock FontWeight="Bold" Text="Printing Page Breaks" />
        <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition Height="10" />
                <RowDefinition />
            </Grid.RowDefinitions>
            <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center" Style="{DynamicResource ThinTextBlockStyle}" Text="Before" TextWrapping="Wrap" />
            <ComboBox x:Name="CbPbBefore" Grid.Row="0" Grid.Column="2" Margin="0,-0.001,0,0" />
            <TextBlock Grid.Row="2" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" Style="{DynamicResource ThinTextBlockStyle}" Text="After" TextWrapping="Wrap" />
            <ComboBox x:Name="CbPbAfter" Grid.Row="2" Grid.Column="2" />
        </Grid>
    </StackPanel>
</UserControl>
