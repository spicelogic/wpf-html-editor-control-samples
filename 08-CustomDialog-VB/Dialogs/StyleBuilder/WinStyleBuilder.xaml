<Window
    x:Class="CustomDialog.Dialogs.StyleBuilder.WinStyleBuilder"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:SpiceLogic.HtmlEditor.WPF.Controls;assembly=SpiceLogic.HtmlEditor.WPF"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ignore="http://www.ignore.com"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Width="1"
    Height="1"
    MinWidth="800"
    MinHeight="650"
    AllowsTransparency="True"
    Background="{x:Null}"
    ResizeMode="CanResizeWithGrip"
    WindowStartupLocation="CenterOwner"
    WindowStyle="None"
    mc:Ignorable="d ignore"
    Loaded="winStyleBuilder_Loaded"
    Closed="winStyleBuilder_Closed">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SpiceLogic.HtmlEditor.WPF;component/Themes/Generic.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <controls:DialogHeader Title="Style Builder" Grid.Row="0" Panel.ZIndex="1" MouseLeftButtonDown="DialogHeader_MouseLeftButtonDown" />
        <controls:PropertyPanel Grid.Row="1" Margin="0,-8" />
        <Grid Grid.Row="1">
            <TabControl x:Name="TabControl" Style="{DynamicResource StyleBuilderTabControlStyle}" TabStripPlacement="Left" SelectionChanged="TabControl_OnSelectionChanged">
                <TabItem Width="126" Height="50"  Header="Font" Style="{DynamicResource StyleBuilderTabItemStyle}" />
                <TabItem Width="126" Height="50"  Header="Background" Style="{DynamicResource StyleBuilderTabItemStyle}" >

                </TabItem>
                <TabItem Width="126" Height="50" Margin="-2,-2,0,-2" Header="Text" Style="{DynamicResource StyleBuilderTabItemStyle}">

                </TabItem>
                <TabItem Width="126" Height="50" Margin="-2,-2,0,-2" Header="Position" Style="{DynamicResource StyleBuilderTabItemStyle}">

                </TabItem>
                <TabItem Width="126" Height="50" Margin="-2,-2,0,-2" Header="Layout" Style="{DynamicResource StyleBuilderTabItemStyle}">

                </TabItem>
                <TabItem Width="126" Height="50" Margin="-2,-2,0,-2" Header="Edges" Style="{DynamicResource StyleBuilderTabItemStyle}">

                </TabItem>
                <TabItem Width="126" Height="50" Margin="-2,-2,0,-2" Header="List position" Style="{DynamicResource StyleBuilderTabItemStyle}">

                </TabItem>
                <TabItem Width="126" Height="50" Margin="-2,-2,0,-2" Header="Other" Style="{DynamicResource StyleBuilderTabItemStyle}">

                </TabItem>
            </TabControl>
        </Grid>
        <Border Grid.Row="2" Height="40" Margin="0,0,0,-8" Background="#FF457C95">
            <CheckBox x:Name="ChkRemoveStyle" Margin="0,0,0,5" HorizontalAlignment="Center" VerticalAlignment="Center" Content="Remove Style (Return Empty String for Style Attribute)" Foreground="White" />
        </Border>
        <controls:TwoButtonPanel Grid.Row="3" OnLeftButtonClicked="TwoButtonPanel_OnLeftButtonClicked" OnRightButtonClicked="TwoButtonPanel_OnRightButtonClicked" />
    </Grid>
</Window>