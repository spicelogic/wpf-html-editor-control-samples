<Window
    x:Class="CustomDialog.Dialogs.ImageDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ignore="http://www.ignore.com"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="clr-namespace:SpiceLogic.HtmlEditor.WPF.Controls;assembly=SpiceLogic.HtmlEditor.WPF"
    Width="1"
    Height="1"
    MinWidth="980"
    MinHeight="475"
    AllowsTransparency="True"
    Background="{x:Null}"
    ResizeMode="CanResizeWithGrip"
    WindowStartupLocation="CenterOwner"
    WindowStyle="None"
    d:DesignHeight="540"
    d:DesignWidth="767"
    mc:Ignorable="d ignore"
    Loaded="ImageInsertDialog_Loaded">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SpiceLogic.HtmlEditor.WPF;component/Themes/Generic.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <controls:DialogHeader Title="Customer Dialog : Image Properties" Grid.Row="0" Panel.ZIndex="1" MouseLeftButtonDown="DialogHeader_MouseLeftButtonDown" />
        <controls:PropertyPanel Grid.Row="1" />
        <StackPanel Grid.Row="1">
            <controls:PropertyBlock TitleOffset="25,-61,25,0">
                <controls:PropertyBlock.Title>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock HorizontalAlignment="Right" Text="Picture" />
                        <TextBlock HorizontalAlignment="Right" Text="Source file" />
                    </StackPanel>
                </controls:PropertyBlock.Title>
                <controls:PropertyBlock.Content>
                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBox x:Name="TxtUrl" Margin="0,0,5,0"/>
                        <Grid Grid.Row="1" Margin="0,5,0,0" HorizontalAlignment="Left">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <RadioButton x:Name="RdoInternet" Margin="0,2" Content="Internet URL" IsChecked="True" Checked="RdoInternetUrl_OnChecked" Unchecked="RdoInternet_OnUnchecked"/>
                                <RadioButton x:Name="RdoWorkingDirFile" Grid.Row="0" Grid.Column="1" Margin="20,2,0,2" HorizontalAlignment="Left" Content="Relative to base URL" Checked="rdoWorkingDirFile_CheckedChanged" Unchecked="rdoWorkingDirFile_CheckedChanged"/>
                                <RadioButton x:Name="RdoLocalFile" Grid.Row="1" Grid.Column="0" Margin="0,2" HorizontalAlignment="Left" Content="Local file with absolute path" Checked="rdoLocalFile_CheckedChanged" Unchecked="rdoLocalFile_CheckedChanged"/>
                                <controls:HyperlinkButton x:Name="LnkBtnBrowseWD" Grid.Row="1" Grid.Column="1" Margin="20,4,0,0" HorizontalAlignment="Left" Text="Browse for a file" IsEnabled="False" Click="lnkBtnBrowseWD_Click"/>
                                <Button x:Name="BtnBrowseFile" Grid.Row="2" Grid.Column="0" MinWidth="100" Height="Auto" HorizontalAlignment="Left" Margin="22,4,0,0" Padding="10,2" Content="Browse" IsEnabled="False" Click="btnBrowseFile_Click"/>

                                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,4,0,0">
                                    <controls:HyperlinkButton x:Name="LnkBtnImportToBaseFolder"  Margin="20,0,0,0" HorizontalAlignment="Left" Text="Import a file to a base folder" IsEnabled="False" Click="lnkBtnImportToBaseFolder_Click" />
                                    <CheckBox x:Name="ChkOverwrite" Margin="10,0,0,0" HorizontalAlignment="Left" Content="Overwrite" IsEnabled="False"/>
                                </StackPanel>
                                <CheckBox x:Name="ChkInsertLocalBase64" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,4,0,0" IsEnabled="False">Insert local image as base64</CheckBox>
                                
                            </Grid>
                        </Grid>
                    </Grid>
                </controls:PropertyBlock.Content>
            </controls:PropertyBlock>
            <controls:PropertyBlock Title="Tooltip">
                <controls:PropertyBlock.Content>
                    <TextBox x:Name="TxtToolTip" />
                </controls:PropertyBlock.Content>
            </controls:PropertyBlock>
            <controls:PropertyBlock>
                <controls:PropertyBlock.Title>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Alternative" />
                        <TextBlock HorizontalAlignment="Right" Text="Text" />
                    </StackPanel>
                </controls:PropertyBlock.Title>
                <controls:PropertyBlock.Content>
                    <TextBox x:Name="TxtAlt" />
                </controls:PropertyBlock.Content>
            </controls:PropertyBlock>
            <controls:PropertyBlock Title="Style" Height="Auto" TitleOffset="25,-33,25,0">
                <controls:PropertyBlock.Content>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" MinWidth="80" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" MinWidth="80" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <CheckBox x:Name="ChkAlignment" HorizontalAlignment="Left" Content="Alignment" Checked="chkAlignment_CheckedChanged" Unchecked="chkAlignment_CheckedChanged"/>
                        <ComboBox x:Name="CmbAlign" Grid.Row="0" Grid.Column="1" Margin="10,0,15,0" IsEnabled="False" Padding="0" IsEditable="True">
                            <ComboBox.Items>
                                <ComboBoxItem>Left</ComboBoxItem>
                                <ComboBoxItem>Right</ComboBoxItem>
                                <ComboBoxItem>Bottom</ComboBoxItem>
                                <ComboBoxItem>Middle</ComboBoxItem>
                                <ComboBoxItem>Top</ComboBoxItem>
                            </ComboBox.Items>
                        </ComboBox>
                        <CheckBox x:Name="ChkBorderColor" Grid.Row="0" Grid.Column="2" Margin="5,0" HorizontalAlignment="Left" Checked="chkBorderColor_CheckedChanged" Unchecked="chkBorderColor_CheckedChanged">
                            <controls:HyperlinkButton x:Name="LnkBtnBgColor" Text="Border Color" IsEnabled="False" Click="lnkBtnBgColor_OnClick"></controls:HyperlinkButton>
                        </CheckBox>
                        <TextBox x:Name="TxtBgColor" Grid.Row="0" Grid.Column="3" Margin="10,0,0,0" DockPanel.Dock="Right" IsEnabled="False" IsReadOnly="True"></TextBox>
                        <CheckBox x:Name="ChkBorderThickness" Grid.Row="2" Grid.Column="0" HorizontalAlignment="Left" Content="Border Thickness" Checked="chkBorderThickness_CheckedChanged" Unchecked="chkBorderThickness_CheckedChanged"/>
                        <TextBox x:Name="TxtBorder" Grid.Row="2" Grid.Column="1" Margin="10,0,15,0" IsEnabled="False"/>
                        <CheckBox x:Name="ChkBorderStyle" Grid.Row="2" Grid.Column="2" Margin="5,0" HorizontalAlignment="Left" Content="Border Style" Checked="chkBorderStyle_CheckedChanged" Unchecked="chkBorderStyle_CheckedChanged"/>
                        <ComboBox x:Name="CmbBorderStyle" Grid.Row="2" Grid.Column="3" Margin="10,0,0,0" IsEnabled="False" Padding="0" IsEditable="True">
                            <ComboBox.Items>
                                <ComboBoxItem>Dotted</ComboBoxItem>
                                <ComboBoxItem>Dashed</ComboBoxItem>
                                <ComboBoxItem>Solid</ComboBoxItem>
                                <ComboBoxItem>Double</ComboBoxItem>
                                <ComboBoxItem>Groove</ComboBoxItem>
                                <ComboBoxItem>Ridge</ComboBoxItem>
                                <ComboBoxItem>Inset</ComboBoxItem>
                                <ComboBoxItem>Outset</ComboBoxItem>
                            </ComboBox.Items>
                        </ComboBox>
                    </Grid>
                </controls:PropertyBlock.Content>
            </controls:PropertyBlock>
            <controls:PropertyBlock Title="Layout" IsSeparatorVisible="False">
                <controls:PropertyBlock.Content>
                    <Grid Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <CheckBox x:Name="ChkLockAspectRatio" HorizontalAlignment="Left" Content="Lock Aspect Ratio" IsChecked="True"/>
                        <StackPanel Grid.Column="1" Margin="30,0,0,0" HorizontalAlignment="Left" Orientation="Horizontal">
                            <CheckBox x:Name="ChkHeight" HorizontalAlignment="Left" Content="Height" Checked="chkHeight_CheckedChanged" Unchecked="chkHeight_CheckedChanged" />
                            <TextBox x:Name="TxtHeight" Width="60" Margin="5,0,0,0" IsEnabled="False" TextChanged="txtHeight_TextChanged"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="20,0,0,0" HorizontalAlignment="Left" Orientation="Horizontal">
                            <CheckBox x:Name="ChkWidth" HorizontalAlignment="Left" Content="Width" Checked="chkWidth_CheckedChanged" Unchecked="chkWidth_CheckedChanged"/>
                            <TextBox x:Name="TxtWidth" Width="60" Margin="5,0,0,0" IsEnabled="False" TextChanged="txtWidth_TextChanged"/>
                        </StackPanel>
                    </Grid>
                </controls:PropertyBlock.Content>
            </controls:PropertyBlock>
        </StackPanel>
        <controls:TwoButtonPanel x:Name="TwoButtonPanel" Grid.Row="2" OnLeftButtonClicked="TwoButtonPanel_OnOnLeftButtonClicked" OnRightButtonClicked="TwoButtonPanel_OnOnRightButtonClicked" />
    </Grid>
</Window>