<Window x:Class="ToolbarCustomizationVB.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:se="clr-namespace:SpiceLogic.HtmlEditor.WPF;assembly=SpiceLogic.HtmlEditor.WPF"
        Title="WPF HTML editor control - toolbar customization (VB.NET)" Height="720" Width="1050" Loaded="MainWindow_OnLoaded">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SpiceLogic.HtmlEditor.WPF;component/Styles/ToolbarStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Description panel -->
        <Border Grid.Row="0" Background="#F0F6FF" BorderBrush="#B0C4DE" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0 0 0 10">
            <StackPanel>
                <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="#1A3A5C" Text="What this sample shows" Margin="0 0 0 6" />
                <TextBlock TextWrapping="Wrap" Foreground="#333" LineHeight="22">
                    The default toolbar below already carries three customizations applied at startup:
                    the <Bold>New</Bold> button is hidden, <Bold>Save</Bold> has a custom icon and a
                    custom click handler, and <Bold>Open</Bold> has a custom tooltip. A plain WPF
                    <Bold>Button</Bold> ("Insert signature") was also appended to the second toolbar
                    strip without touching a single factory button. Click
                    <Bold>Build a fully custom toolbar</Bold> below to see a different technique: hide
                    both built-in toolbars entirely and hand assemble your own from just the buttons
                    you want, in the order you want, plus a brand-new icon button.
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- Action row -->
        <WrapPanel Grid.Row="1" Margin="0 0 0 8">
            <Button x:Name="BuildCustomToolbarButton" Content="Build a fully custom toolbar"
                    Padding="12,6" Click="BuildCustomToolbarButton_Click" />
        </WrapPanel>

        <!-- Custom toolbar, populated and shown once "Build a fully custom toolbar" is clicked -->
        <ToolBarTray x:Name="CustomToolbarTray" Grid.Row="2" Margin="0 0 0 8" Visibility="Collapsed">
            <ToolBar x:Name="CustomToolBar" Style="{DynamicResource EditorToolBarStyle}" />
        </ToolBarTray>

        <se:WpfHtmlEditor x:Name="Editor" Grid.Row="3" />
    </Grid>
</Window>
