<Window x:Class="ThemeAndAppearance.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:se="clr-namespace:SpiceLogic.HtmlEditor.WPF;assembly=SpiceLogic.HtmlEditor.WPF"
        Title="WPF HTML editor control - theme and appearance" Height="700" Width="950">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <se:WpfHtmlEditor x:Name="Editor" Grid.Row="0" />

        <WrapPanel Grid.Row="1" Margin="0,8,0,0">
            <Button x:Name="BrandBorderButton" Content="Apply brand border" Padding="12,6"
                    Margin="0,0,8,0" Click="BrandBorderButton_Click" />
            <Button x:Name="DocumentFontButton" Content="Apply document font" Padding="12,6"
                    Margin="0,0,8,0" Click="DocumentFontButton_Click" />
            <Button x:Name="DesignModeButton" Content="Design view" Padding="12,6"
                    Margin="0,0,8,0" Click="DesignModeButton_Click" />
            <Button x:Name="SourceModeButton" Content="Source view" Padding="12,6"
                    Click="SourceModeButton_Click" />
        </WrapPanel>
    </Grid>
</Window>
