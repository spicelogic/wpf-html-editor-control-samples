<Window x:Class="MailMergeTemplate.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:se="clr-namespace:SpiceLogic.HtmlEditor.WPF;assembly=SpiceLogic.HtmlEditor.WPF"
        Title="WPF HTML editor control - mail merge template" Height="800" Width="1000">
    <!-- The template and the preview are stacked rather than placed side by side, so each
         editor keeps the full window width and its complete toolbar stays visible. -->
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,4">
            <TextBlock DockPanel.Dock="Top" Text="Template (drop in merge fields with the placeholder toolbar)"
                       FontWeight="Bold" Margin="0,0,0,4" />
            <se:WpfHtmlEditor x:Name="Editor" />
        </DockPanel>

        <DockPanel Grid.Row="1" Margin="0,4,0,0">
            <TextBlock DockPanel.Dock="Top" Text="Preview (placeholders substituted from a sample record)"
                       FontWeight="Bold" Margin="0,0,0,4" />
            <se:WpfHtmlEditor x:Name="PreviewEditor" EditorMode="ReadOnlyPreview" />
        </DockPanel>

        <Button Grid.Row="2" x:Name="PreviewButton"
                Content="Preview merged" HorizontalAlignment="Left" Padding="12,6"
                Margin="0,8,0,0" Click="PreviewButton_Click" />
    </Grid>
</Window>
