<Window x:Class="MailMergeTemplate.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:se="clr-namespace:SpiceLogic.HtmlEditor.WPF;assembly=SpiceLogic.HtmlEditor.WPF"
        Title="WPF HTML editor control - mail merge template" Height="700" Width="1200">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Row="0" Grid.Column="0" Margin="0,0,4,0">
            <TextBlock DockPanel.Dock="Top" Text="Template (drop in merge fields with the placeholder toolbar)"
                       FontWeight="Bold" Margin="0,0,0,4" />
            <se:WpfHtmlEditor x:Name="Editor" />
        </DockPanel>

        <DockPanel Grid.Row="0" Grid.Column="1" Margin="4,0,0,0">
            <TextBlock DockPanel.Dock="Top" Text="Preview (placeholders substituted from a sample record)"
                       FontWeight="Bold" Margin="0,0,0,4" />
            <se:WpfHtmlEditor x:Name="PreviewEditor" EditorMode="ReadOnlyPreview" />
        </DockPanel>

        <Button Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" x:Name="PreviewButton"
                Content="Preview merged" HorizontalAlignment="Left" Padding="12,6"
                Margin="0,8,0,0" Click="PreviewButton_Click" />
    </Grid>
</Window>
