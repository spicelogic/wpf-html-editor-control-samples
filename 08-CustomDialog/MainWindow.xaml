<Window WindowState="Maximized"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wpfHtmlEditor="clr-namespace:SpiceLogic.HtmlEditor.WPF;assembly=SpiceLogic.HtmlEditor.WPF"
        x:Class="CustomDialog.MainWindow"
        Title="SpiceLogic WPF HTML Editor - Custom Dialog Demo" Height="700" Width="1000" Loaded="MainWindow_OnLoaded">
    <Grid Margin="10" UseLayoutRounding="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#F0F6FF" BorderBrush="#B0C4DE" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0 0 0 12">
            <StackPanel>
                <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="#1A3A5C" Text="What this demo shows" Margin="0 0 0 6"/>
                <TextBlock TextWrapping="Wrap" Foreground="#333" LineHeight="22">
                    The HTML Editor uses built-in dialogs for inserting images, hyperlinks, tables, symbols, and more.
                    If you need to match your application's look and feel, you can replace any or all of these dialogs
                    with your own custom implementations. This project contains complete source code for every dialog,
                    ready for you to customize.
                </TextBlock>
                <TextBlock TextWrapping="Wrap" Foreground="#333" Margin="0 8 0 0" LineHeight="22">
                    <Bold>Try it:</Bold> use the toolbar to insert an image, hyperlink, or table - each action opens
                    a custom dialog instead of the built-in one. Check the <Bold>Dialogs</Bold> folder in this
                    project to see and modify the source code. Look at the code-behind to see how each custom dialog
                    is wired up via the <Bold>Dialog.CreateXxxDialogMethod</Bold> properties.
                </TextBlock>
            </StackPanel>
        </Border>
        <wpfHtmlEditor:WpfHtmlEditor x:Name="WpfHtmlEditor" Grid.Row="1"/>

    </Grid>
</Window>
