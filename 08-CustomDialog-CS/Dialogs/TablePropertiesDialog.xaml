<Window
    x:Class="CustomDialog.Dialogs.TablePropertiesDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:SpiceLogic.HtmlEditor.WPF.Controls;assembly=SpiceLogic.HtmlEditor.WPF"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ignore="http://www.ignore.com"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Width="1"
    Height="1"
    MinWidth="990"
    MinHeight="485"
    AllowsTransparency="True"
    Background="{x:Null}"
    ResizeMode="CanResizeWithGrip"
    WindowStartupLocation="CenterOwner"
    WindowStyle="None"
    d:DesignHeight="540"
    d:DesignWidth="747"
    mc:Ignorable="d ignore" Loaded="TablePropertiesDialog_Loaded">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SpiceLogic.HtmlEditor.WPF;component/Themes/Generic.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <controls:DialogHeader Title="Custom Dialog : Table Properties" Grid.Row="0" Panel.ZIndex="1" MouseLeftButtonDown="DialogHeader_MouseLeftButtonDown" />
        <controls:PropertyPanel Grid.Row="1" />
        <StackPanel Grid.Row="1">
            <controls:PropertyBlock Title="Layout" Height="Auto" TitleOffset="25,-72,25,0">
                <controls:PropertyBlock.Content>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" MinWidth="80" />
                            <ColumnDefinition Width="Auto" MinWidth="60" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" MinWidth="80" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <CheckBox x:Name="ChkWidth" HorizontalAlignment="Left" Content="Set Width" Checked="chkWidth_CheckedChanged" Unchecked="chkWidth_CheckedChanged"/>
                        <TextBox x:Name="TxtWidth" Grid.Row="0" Grid.Column="1" Margin="5,0" IsEnabled="False"></TextBox>
                        <ComboBox x:Name="CmbWidthUnit" Grid.Row="0" Grid.Column="2" Margin="5,0" IsEnabled="False" IsEditable="True" Padding="0">
                            <ComboBoxItem>px</ComboBoxItem>
                            <ComboBoxItem>%</ComboBoxItem>
                            <ComboBoxItem>pt</ComboBoxItem>
                            <ComboBoxItem>pc</ComboBoxItem>
                            <ComboBoxItem>mm</ComboBoxItem>
                            <ComboBoxItem>cm</ComboBoxItem>
                            <ComboBoxItem>in</ComboBoxItem>
                            <ComboBoxItem>em</ComboBoxItem>
                            <ComboBoxItem>ex</ComboBoxItem>
                        </ComboBox>
                        <TextBlock Grid.Row="0" Grid.Column="3" Margin="5,0" HorizontalAlignment="Left" VerticalAlignment="Center" Style="{StaticResource ThinTextBlockStyle}" Text="Rows" />
                        <controls:NumericUpDown x:Name="NumRows" Grid.Row="0" Grid.Column="4" IncrementValue="1" Minimum="1" Maximum="50" Precision="0" Value="3"/>
                        <CheckBox x:Name="ChkHeight" Grid.Row="2" Grid.Column="0" HorizontalAlignment="Left" Content="Set Height" Checked="chkHeight_CheckedChanged" Unchecked="chkHeight_CheckedChanged"/>
                        <TextBox x:Name="TxtHeight" Grid.Row="2" Grid.Column="1" Margin="5,0" IsEnabled="False"></TextBox>
                        <ComboBox x:Name="CmbHeightUnit" Grid.Row="2" Grid.Column="2" Margin="5,0" IsEnabled="False" IsEditable="True" Padding="0">
                            <ComboBoxItem>px</ComboBoxItem>
                            <ComboBoxItem>%</ComboBoxItem>
                            <ComboBoxItem>pt</ComboBoxItem>
                            <ComboBoxItem>pc</ComboBoxItem>
                            <ComboBoxItem>mm</ComboBoxItem>
                            <ComboBoxItem>cm</ComboBoxItem>
                            <ComboBoxItem>in</ComboBoxItem>
                            <ComboBoxItem>em</ComboBoxItem>
                            <ComboBoxItem>ex</ComboBoxItem>
                        </ComboBox>
                        <TextBlock Grid.Row="2" Grid.Column="3" Margin="5,0" HorizontalAlignment="Left" VerticalAlignment="Center" Style="{StaticResource ThinTextBlockStyle}" Text="Columns" />
                        <controls:NumericUpDown x:Name="NumCols" Grid.Row="2" Grid.Column="4" IncrementValue="1" Value="3" Minimum="1" Maximum="50" Precision="0"/>
                        <CheckBox x:Name="ChkCaption" Grid.Row="4" Grid.Column="0" Checked="chkCaption_CheckedChanged" Unchecked="chkCaption_CheckedChanged">Caption</CheckBox>
                        <TextBox x:Name="TxtCaption" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="4" Margin="5 0 0 0" IsEnabled="False"/>
                    </Grid>
                </controls:PropertyBlock.Content>
            </controls:PropertyBlock>
            <controls:PropertyBlock Title="Attributes" Height="Auto" TitleOffset="25,-183,25,0">
                <controls:PropertyBlock.Content>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" MinWidth="80" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" MinWidth="80" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="5" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="5" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="5" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="5" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="5" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="5" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <CheckBox x:Name="ChkBorderWidth" HorizontalAlignment="Left" Content="Border Width" IsChecked="True" Checked="chkBorderWidth_CheckedChanged" Unchecked="chkBorderWidth_CheckedChanged"/>
                        <controls:NumericUpDown x:Name="NumBorderWidth" Grid.Row="0" Grid.Column="1" Margin="5,0" Value="1" Minimum="0" Maximum="99" Precision="0" ValueChanged="numBorderWidth_ValueChanged"/>
                        <CheckBox x:Name="ChkCellPadding" Grid.Row="0" Grid.Column="2" Margin="5,0" HorizontalAlignment="Left" Content="Cell Padding" Checked="chkCellPadding_CheckedChanged" Unchecked="chkCellPadding_CheckedChanged"/>
                        <controls:NumericUpDown x:Name="NumCellPadding" Grid.Row="0" Grid.Column="3" IncrementValue="1" Value="0" Minimum="0" Maximum="99" Precision="0" IsEnabled="False"/>
                        <CheckBox x:Name="ChkBorderColor" Grid.Row="2" Grid.Column="0" HorizontalAlignment="Left" IsChecked="True" Checked="chkBorderColor_CheckedChanged" Unchecked="chkBorderColor_CheckedChanged">
                            <controls:HyperlinkButton x:Name="LnkButtonBorderColor" HorizontalAlignment="Center" Text="Border Color" IsEnabled="False" Click="lnkButtonBorderColor_OnClick"/>
                        </CheckBox>
                        <TextBox x:Name="TxtBorderColor" Grid.Row="2" Grid.Column="1" Margin="5,0" IsReadOnly="True" IsEnabled="False"/>
                        <CheckBox x:Name="ChkCellSpacing" Grid.Row="2" Grid.Column="2" Margin="5,0" HorizontalAlignment="Left" Content="Cell Spacing" Checked="chkCellSpacing_CheckedChanged" Unchecked="chkCellSpacing_CheckedChanged"/>
                        <controls:NumericUpDown x:Name="NumCellSpacing" Grid.Row="2" Grid.Column="3" IncrementValue="1" Value="0" Minimum="0" Maximum="99" Precision="0" IsEnabled="False"/>
                        <CheckBox x:Name="ChkBorderStyle" Grid.Row="4" Grid.Column="0" HorizontalAlignment="Left" Content="Border Style" Checked="chkBorderStyle_CheckedChanged" Unchecked="chkBorderStyle_CheckedChanged" />
                        <ComboBox x:Name="CmbBorderStyle" Grid.Row="4" Grid.Column="1" Margin="5,0" IsEditable="True" Padding="0">
                            <ComboBoxItem>Dotted</ComboBoxItem>
                            <ComboBoxItem>Dashed</ComboBoxItem>
                            <ComboBoxItem>Solid</ComboBoxItem>
                            <ComboBoxItem>Double</ComboBoxItem>
                            <ComboBoxItem>Groove</ComboBoxItem>
                            <ComboBoxItem>Ridge</ComboBoxItem>
                            <ComboBoxItem>Inset</ComboBoxItem>
                            <ComboBoxItem>Outset</ComboBoxItem>
                        </ComboBox>
                        <CheckBox x:Name="ChkBgColor" Grid.Row="4" Grid.Column="2" Margin="5,0" HorizontalAlignment="Left" IsChecked="True" Checked="chkBgColor_CheckedChanged" Unchecked="chkBgColor_CheckedChanged">
                            <controls:HyperlinkButton x:Name="LnkButtonBgColor" HorizontalAlignment="Center" Text="Background Color" IsEnabled="False" Click="lnkButtonBgColor_OnClick"/>
                        </CheckBox>
                        <TextBox x:Name="TxtBgColor" Grid.Row="4" Grid.Column="3" IsReadOnly="True" IsEnabled="False"></TextBox>
                        <CheckBox x:Name="ChkBorderCollapse" Grid.Row="6" Grid.Column="0" HorizontalAlignment="Left" Content="Border Collapse" />
                        <CheckBox x:Name="ChkBackgroundPicture" Grid.Row="6" Grid.Column="2" Margin="5,0" HorizontalAlignment="Left" IsChecked="True" Checked="chkBackgroundPicture_OnCheckedChanged" Unchecked="chkBackgroundPicture_OnCheckedChanged">
                            <controls:HyperlinkButton x:Name="LnkBtnBackgroundPicture" HorizontalAlignment="Center" Text="Background Picture" Click="lnkBtnBackgroundPicture_Click"/>
                        </CheckBox>
                        <CheckBox x:Name="ChkBorderToAll" Grid.Row="8" Grid.Column="0" HorizontalAlignment="Left" Content="Apply border to cells" IsChecked="True"/>
                        <Image x:Name="ImgBackgroundPicture" Grid.Row="8" Grid.Column="2" Grid.RowSpan="3" Grid.ColumnSpan="2"></Image>
                        <DockPanel Grid.Row="10" Grid.Column="0" Grid.ColumnSpan="2">
                            <TextBlock HorizontalAlignment="Left">Class Name</TextBlock>
                            <TextBox x:Name="TxtClassName" DockPanel.Dock="Right" Margin="5,0"/>
                        </DockPanel>
                        <DockPanel Grid.Row="12" Grid.Column="0" Grid.ColumnSpan="4">
                            <TextBlock >CSS</TextBlock>
                            <TextBox x:Name="TxtCss" Margin="5 0 0 0"></TextBox>
                        </DockPanel>
                    </Grid>
                </controls:PropertyBlock.Content>
            </controls:PropertyBlock>
            <controls:PropertyBlock IsSeparatorVisible="False">
                <controls:PropertyBlock.Title>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock HorizontalAlignment="Right" Text="Summary" />
                        <TextBlock HorizontalAlignment="Right" Text="Description" />
                    </StackPanel>
                </controls:PropertyBlock.Title>
                <controls:PropertyBlock.Content>
                    <DockPanel>
                        <Button x:Name="BtnCellProperties" MinWidth="144" Padding="10,2" Height="Auto" Margin="5,0,0,0" Content="Cell properties" DockPanel.Dock="Right" Click="btnCellProperties_Click"/>
                        <TextBox x:Name="TxtSummaryDescription" Margin="0,0,5,0" />
                    </DockPanel>
                </controls:PropertyBlock.Content>
            </controls:PropertyBlock>
        </StackPanel>
        <controls:TwoButtonPanel Grid.Row="2" OnLeftButtonClicked="TwoButtonPanel_OnLeftButtonClicked" OnRightButtonClicked="TwoButtonPanel_OnRightButtonClicked" />
        <TextBox x:Name="TxtId" HorizontalAlignment="Left" Height="23" Margin="10,41,0,0" Grid.Row="1" TextWrapping="Wrap" Text="TextBox" VerticalAlignment="Top" Width="120"/>
        <TextBox x:Name="TxtName" HorizontalAlignment="Left" Height="23" Margin="10,69,0,0" Grid.Row="1" TextWrapping="Wrap" Text="TextBox" VerticalAlignment="Top" Width="120"/>
    </Grid>
</Window>