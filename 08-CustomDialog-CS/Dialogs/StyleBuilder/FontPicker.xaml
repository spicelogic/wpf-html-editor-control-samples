<Window x:Class="CustomDialog.Dialogs.StyleBuilder.FontPicker"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Font Picker" Height="400" Width="600" Loaded="fontPicker_Loaded">
    
    <Window.Resources>
        <ResourceDictionary>
            <Style TargetType="Button">
                <Setter Property="Padding" Value="10 5"></Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"></ColumnDefinition>
            <ColumnDefinition Width="Auto"></ColumnDefinition>
            <ColumnDefinition Width="1*"></ColumnDefinition>
            <ColumnDefinition Width="Auto"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Label Grid.ColumnSpan="4">Create a font sequence in order of preference:</Label>
        <Label Grid.Row="1" Grid.Column="0" Target="{Binding ElementName=LbInstalledFonts}">_Installed Fonts:</Label>
        <Label Grid.Row="1" Grid.Column="2" Target="{Binding ElementName=LbSelectedFonts}" Margin="10 0 0 0">_Selected Fonts:</Label>
        <ListBox x:Name="LbInstalledFonts" Grid.Row="2" Grid.Column="0">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock  Text="{Binding}" FontFamily="{Binding}" FontSize="14" Height="20"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <Button Grid.Row="2" Grid.Column="1" VerticalAlignment="Top" Margin="10 0 0 0" Click="btAddInstalledFont_Click">>>></Button>
        <ListBox x:Name="LbSelectedFonts" Grid.Row="2" Grid.Column="2" Grid.RowSpan="3" Margin="10 0 0 0" SelectionChanged="lbSelectedFonts_SelectedChanged"></ListBox>
        <StackPanel Grid.Row="2" Grid.Column="3" Margin="10 0 0 0">
            <Button x:Name="BtMoveUp" Click="btMoveUp_Click">Move _Up</Button>
            <Button x:Name="BtMoveDown" Margin="0 10 0 0" Click="btMoveDown_Click">Move _Down</Button>
        </StackPanel>
        <StackPanel Grid.Row="3" Grid.Column="0">
            <Label Target="{Binding ElementName=CbGenericFonts}">_Generic Fonts:</Label>
            <ComboBox x:Name="CbGenericFonts">
                <ComboBoxItem>Monospace</ComboBoxItem>
                <ComboBoxItem>Serif</ComboBoxItem>
                <ComboBoxItem>Sans-Serif</ComboBoxItem>
                <ComboBoxItem>Cursive</ComboBoxItem>
                <ComboBoxItem>Fantasy</ComboBoxItem>
            </ComboBox>
        </StackPanel>
        <Button Grid.Row="3" Grid.Column="1" VerticalAlignment="Bottom" Margin="10 0 0 0" Click="btAddGenericFont_Click">>>></Button>
        <StackPanel Grid.Row="4" Grid.Column="0">
            <Label Target="{Binding ElementName=TbCustomFont}">_Custom font:</Label>
            <TextBox x:Name="TbCustomFont" TextChanged="tbCustomFont_TextChanged"></TextBox>
        </StackPanel>
        <Button x:Name="BtAddCustomFont" Grid.Row="4" Grid.Column="1" VerticalAlignment="Bottom" Margin="10 0 0 0" Click="brAddCustomFont_Click">>>></Button>
        <Button x:Name="BtRemove" Grid.Row="4" Grid.Column="3" VerticalAlignment="Bottom" Margin="10 0 0 0" Click="btRemove_Click">_Remove</Button>
        <StackPanel Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0 10 0 0">
            <Button IsDefault="True" Click="btOk_Click">OK</Button>
            <Button Margin="10 0 0 0" IsCancel="True" Click="btCancel_Click">Cancel</Button>
        </StackPanel>
    </Grid>
</Window>
