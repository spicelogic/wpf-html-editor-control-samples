<UserControl x:Class="CustomDialog.Dialogs.StyleBuilder.ucBackground"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             Loaded="ucBackground_Loaded" d:DesignHeight="400" d:DesignWidth="522">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SpiceLogic.HtmlEditor.WPF;component/Themes/Generic.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel Margin="20,10,10,10">
        <TextBlock Height="19.503" FontWeight="Bold" Text="Background Color" />
        <StackPanel Margin="0,10,0,0" HorizontalAlignment="Left" Orientation="Horizontal">
            <TextBox x:Name="TxtBgColor" Width="200" IsEnabled="False" IsReadOnly="True" Foreground="White" PreviewMouseDown="TxtBgColor_OnPreviewMouseDown"/>
            <CheckBox x:Name="CbBgColorTransparent" Margin="10,0,0,0" Content="Transparent" IsChecked="True" Checked="cbBgColorTransparent_CheckedChanged" Unchecked="cbBgColorTransparent_CheckedChanged"/>
        </StackPanel>
        <Border Height="1" Margin="0,10" Background="{DynamicResource PropertyBlockSeparatorBrush}" />
        <TextBlock FontWeight="Bold" Text="Background Image" />
        <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition Height="10" />
                <RowDefinition />
                <RowDefinition Height="10" />
                <RowDefinition />
            </Grid.RowDefinitions>
            <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center" Style="{DynamicResource ThinTextBlockStyle}" Text="Image" TextWrapping="Wrap" />
            <Grid Grid.Row="0" Grid.Column="2" Height="35">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="100" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TbBgImage" Margin="0" TextChanged="tbBgImage_TextChanged"/>
                <Button x:Name="BtChooseBgImage" Grid.Column="2" VerticalAlignment="Center" Content="Browse" Click="btChooseBgImage_Click"/>
            </Grid>
            <TextBlock Grid.Row="2" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" Style="{DynamicResource ThinTextBlockStyle}" Text="Tiling" TextWrapping="Wrap" />
            <ComboBox x:Name="CbTiling" Grid.Row="2" Grid.Column="2" />
            <TextBlock Grid.Row="4" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5" Style="{DynamicResource ThinTextBlockStyle}" Text="Scrolling" TextWrapping="Wrap">
                <TextBlock.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform />
                        <SkewTransform />
                        <RotateTransform />
                        <TranslateTransform Y="2" />
                    </TransformGroup>
                </TextBlock.RenderTransform>
            </TextBlock>
            <ComboBox x:Name="CbScrolling" Grid.Row="4" Grid.Column="2" RenderTransformOrigin="0.5,0.5" />
        </Grid>
        <Border Height="1" Margin="0,10" Background="{DynamicResource PropertyBlockSeparatorBrush}" />
        <GroupBox x:Name="GbPosition" Header="Position" Margin="-6">
            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition Height="10" />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center" Style="{DynamicResource ThinTextBlockStyle}" Text="Horizontal" TextWrapping="Wrap" />
                <ComboBox x:Name="CbHorizontal" Grid.Row="0" Grid.Column="2" SelectionChanged="cbHorizontal_SelectionChanged"/>
                <TextBox x:Name="TbHorCust" Grid.Row="0" Grid.Column="4"></TextBox>
                <ComboBox x:Name="CbHorCustType" Grid.Row="0" Grid.Column="6">
                    <ComboBoxItem>px</ComboBoxItem>
                    <ComboBoxItem>%</ComboBoxItem>
                    <ComboBoxItem>pt</ComboBoxItem>
                    <ComboBoxItem>pc</ComboBoxItem>
                    <ComboBoxItem>mm</ComboBoxItem>
                    <ComboBoxItem>cm</ComboBoxItem>
                    <ComboBoxItem>in</ComboBoxItem>
                    <ComboBoxItem>em</ComboBoxItem>
                    <ComboBoxItem>ex</ComboBoxItem>
                </ComboBox>

                <TextBlock Grid.Row="2" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" Style="{DynamicResource ThinTextBlockStyle}" Text="Vertical" TextWrapping="Wrap" />
                <ComboBox x:Name="CbVertical" Grid.Row="2" Grid.Column="2" SelectionChanged="cbVertical_SelectionChanged"/>
                <TextBox x:Name="TbVerCust" Grid.Row="2" Grid.Column="4"></TextBox>
                <ComboBox x:Name="CbVerCustType" Grid.Row="2" Grid.Column="6">
                    <ComboBoxItem>px</ComboBoxItem>
                    <ComboBoxItem>%</ComboBoxItem>
                    <ComboBoxItem>pt</ComboBoxItem>
                    <ComboBoxItem>pc</ComboBoxItem>
                    <ComboBoxItem>mm</ComboBoxItem>
                    <ComboBoxItem>cm</ComboBoxItem>
                    <ComboBoxItem>in</ComboBoxItem>
                    <ComboBoxItem>em</ComboBoxItem>
                    <ComboBoxItem>ex</ComboBoxItem>
                </ComboBox>
            </Grid>
        </GroupBox>
        <CheckBox x:Name="CbDoNotUseBackground" Margin="0,10,0,0" Content="Do not use background image" Checked="cbDoNotUseBackground_CheckedChanged" Unchecked="cbDoNotUseBackground_CheckedChanged"/>
    </StackPanel>
</UserControl>
