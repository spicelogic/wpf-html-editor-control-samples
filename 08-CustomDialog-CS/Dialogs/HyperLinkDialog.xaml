<Window
    x:Class="CustomDialog.Dialogs.HyperLinkDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:SpiceLogic.HtmlEditor.WPF.Controls;assembly=SpiceLogic.HtmlEditor.WPF"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ignore="http://www.ignore.com"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Width="1"
    Height="1"
    MinWidth="1020"
    MinHeight="360"
    AllowsTransparency="True"
    Background="{x:Null}"
    ResizeMode="CanResizeWithGrip"
    WindowStartupLocation="CenterOwner"
    WindowStyle="None"
    d:DesignHeight="459"
    d:DesignWidth="777"
    mc:Ignorable="d ignore" Loaded="HyperLinkDialog_Loaded">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SpiceLogic.HtmlEditor.WPF;component/Themes/Generic.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <controls:DialogHeader Title="Custom Dialog : Hyperlink Properties" Grid.Row="0" Panel.ZIndex="1" MouseLeftButtonDown="DialogHeader_MouseLeftButtonDown" />
        <controls:PropertyPanel Grid.Row="1" />
        <StackPanel Grid.Row="1">
            <controls:PropertyBlock>
                <controls:PropertyBlock.Title>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Inner HTML" />
                        <TextBlock HorizontalAlignment="Right" Text="(or text)" />
                    </StackPanel>
                </controls:PropertyBlock.Title>
                <controls:PropertyBlock.Content>
                    <TextBox x:Name="TxtInnerHtml" />
                </controls:PropertyBlock.Content>
            </controls:PropertyBlock>
            <controls:PropertyBlock Title="URL" TitleOffset="25,-56,25,0">
                <controls:PropertyBlock.Content>
                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <DockPanel>
                            <ComboBox x:Name="CmbTarget" MinWidth="120" Padding="0" Margin="5,0" DockPanel.Dock="Right" IsEnabled="False" IsEditable="True">
                                <ComboBox.Items>
                                    <ComboBoxItem>_blank</ComboBoxItem>
                                    <ComboBoxItem>_parent</ComboBoxItem>
                                    <ComboBoxItem>_search</ComboBoxItem>
                                    <ComboBoxItem>_self</ComboBoxItem>
                                    <ComboBoxItem>_top</ComboBoxItem>
                                </ComboBox.Items>
                            </ComboBox>
                            <CheckBox x:Name="ChkTargetIncluded" Margin="5,0,0,0" Content="Target" DockPanel.Dock="Right" Checked="chkTargetIncluded_CheckedChanged" Unchecked="chkTargetIncluded_CheckedChanged"/>
                            <TextBox x:Name="TxtURL" Margin="0,0,5,0" />
                        </DockPanel>
                        <Grid Grid.Row="1" Margin="0,5,0,0" HorizontalAlignment="Left">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <RadioButton Margin="0,2" Content="Internet URL" IsChecked="True"/>
                                <RadioButton x:Name="RdoWorkingDirFile" Grid.Row="0" Grid.Column="1" Margin="20,2,0,2" HorizontalAlignment="Left" Content="Relative to base URL" Checked="rdoWorkingDirFile_CheckedChanged" Unchecked="rdoWorkingDirFile_CheckedChanged"/>
                                <RadioButton x:Name="RdoLocalFile" Grid.Row="1" Grid.Column="0" Margin="0,2" HorizontalAlignment="Left" Content="Local file with absolute path" Checked="rdoLocalFile_CheckedChanged" Unchecked="rdoLocalFile_CheckedChanged"/>
                                <Button x:Name="BtnBrowseFile" Grid.Row="2" Grid.Column="0" Margin="22,4,0,0" MinWidth="100" Padding="10,2" Content="Browse" IsEnabled="False" Click="btnBrowseFile_Click" HorizontalAlignment="Left"/>
                                
                                <controls:HyperlinkButton x:Name="LnkBtnBrowseWD" Grid.Row="1" Grid.Column="1" Margin="20,4,0,0" HorizontalAlignment="Left" Text="Browse for a file" IsEnabled="False" Click="lnkBtnBrowseWD_Click"/>
                                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,4,0,0">
                                    <controls:HyperlinkButton x:Name="LnkBtnImportToBaseFolder"  Margin="20,0,0,0" HorizontalAlignment="Left" Text="Import a file to a base folder" IsEnabled="False" Click="lnkBtnImportToBaseFolder_Click"/>
                                    <CheckBox x:Name="ChkOverwrite" Margin="10,0,0,0" HorizontalAlignment="Left" Content="Overwrite" IsEnabled="False" />
                                </StackPanel>
                                
                            </Grid>
                        </Grid>
                    </Grid>
                </controls:PropertyBlock.Content>
            </controls:PropertyBlock>
            <controls:PropertyBlock Title="Tooltip">
                <controls:PropertyBlock.Content>
                    <TextBox x:Name="TxtToolTip"/>
                </controls:PropertyBlock.Content>
            </controls:PropertyBlock>
            <controls:PropertyBlock Title="Action" IsSeparatorVisible="False">
                <controls:PropertyBlock.Content>
                    <StackPanel Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Center" Orientation="Horizontal">
                        <CheckBox x:Name="ChkRemoveLink" HorizontalAlignment="Left" Content="Remove Link" />
                        <controls:HyperlinkButton Margin="20,2,0,0" Text="Check URL" Click="lnkBtnCheck_Click"/>
                    </StackPanel>
                </controls:PropertyBlock.Content>
            </controls:PropertyBlock>
        </StackPanel>
        <controls:TwoButtonPanel Grid.Row="2" OnLeftButtonClicked="TwoButtonPanel_OnOnLeftButtonClicked" OnRightButtonClicked="TwoButtonPanel_OnOnRightButtonClicked" />
    </Grid>
</Window>