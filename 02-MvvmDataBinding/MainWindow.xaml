<Window x:Class="MvvmDataBinding.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:se="clr-namespace:SpiceLogic.HtmlEditor.WPF;assembly=SpiceLogic.HtmlEditor.WPF"
        Title="WPF HTML editor control - MVVM data binding" Height="700" Width="950">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--
            Two-way bound to the view model's Html property. UpdateSourceTrigger=LostFocus is the
            editor's own default and is intentional: switching this to PropertyChanged pushes the
            view model setter on every keystroke, paste and toolbar action, which thrashes the
            garbage collector and can make a change handler fight the caret. LostFocus writes one
            snapshot per editing session. When you need the latest value without waiting for a
            focus change, call Editor.UpdateBindings() first, as the Save button below does.
        -->
        <se:WpfHtmlEditor x:Name="Editor" Grid.Row="0"
                           BodyHtml="{Binding Html, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />

        <StackPanel Grid.Row="1" Margin="0,8,0,0">
            <TextBlock Text="Current view model value (the Html property):" FontWeight="Bold" />
            <TextBox x:Name="ViewModelValueText" Text="{Binding Html, Mode=OneWay}" Height="90"
                     TextWrapping="Wrap" AcceptsReturn="True" IsReadOnly="True"
                     VerticalScrollBarVisibility="Auto" FontFamily="Consolas" />
        </StackPanel>

        <Button x:Name="SaveButton" Grid.Row="2" Content="Save to view model"
                HorizontalAlignment="Left" Padding="12,6" Margin="0,8,0,0"
                Click="SaveButton_Click" />
    </Grid>
</Window>
