<Window WindowState="Maximized"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:se="clr-namespace:SpiceLogic.HtmlEditor.WPF;assembly=SpiceLogic.HtmlEditor.WPF"
        xmlns:userOptions="clr-namespace:SpiceLogic.HtmlEditor.WPF.Models.BOs.UserOptions;assembly=SpiceLogic.HtmlEditor.WPF"
        xmlns:designTime="clr-namespace:SpiceLogic.HtmlEditor.Abstractions.DesignTime;assembly=SpiceLogic.HtmlEditor.Abstractions"
        x:Class="CustomSpellChecker.MainWindow"
        Title="WPF HTML editor control - custom spell checker engine" Height="650" Width="1000" Loaded="MainWindow_OnLoaded">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <!-- Description panel -->
        <Border Grid.Row="0" Background="#F0F6FF" BorderBrush="#B0C4DE" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0 0 0 12">
            <StackPanel>
                <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="#1A3A5C" Text="What this sample shows" Margin="0 0 0 6"/>
                <TextBlock TextWrapping="Wrap" Foreground="#333" LineHeight="22">
                    The editor ships with a built-in spell checker. When an application needs a specialized
                    dictionary instead (medical, legal, or multilingual), a custom spell-checking engine can be
                    plugged in by implementing the <Bold>ISpellCheckerEngine</Bold> interface.
                </TextBlock>
                <TextBlock TextWrapping="Wrap" Foreground="#333" Margin="0 8 0 0" LineHeight="22">
                    <Bold>Try it:</Bold> switch between the two engines below. The <Italic>Built-In Engine</Italic> uses a real
                    English dictionary. The <Italic>Custom Engine</Italic> is a simple demo that flags every word starting
                    with the letter "<Bold>a</Bold>" as misspelled, showing how any spell-check logic can be wired in.
                    Type a word and press <Bold>Space</Bold> to trigger inline spell checking - misspelled words appear
                    with a curly underline. Right-click on an underlined word to see suggestions.
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- Engine selector -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0 0 0 10">
            <TextBlock Text="Spell check engine:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0 0 12 0"/>
            <RadioButton x:Name="BuiltInRadio" IsChecked="True" Content="Built-in engine" VerticalAlignment="Center" Margin="0 0 20 0"
                         Checked="BuiltInRadio_OnCheckedChanged" Unchecked="BuiltInRadio_OnCheckedChanged"/>
            <RadioButton Content="Custom engine (demo)" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- HTML editor -->
        <se:WpfHtmlEditor x:Name="Editor" Grid.Row="2">
            <se:WpfHtmlEditor.SpellCheckOptions>
                <userOptions:SpellCheckerOption FireInlineSpellCheckingOnKeyStroke="True">
                    <userOptions:SpellCheckerOption.DictionaryFile>
                        <designTime:DictionaryFileInfo/>
                    </userOptions:SpellCheckerOption.DictionaryFile>
                </userOptions:SpellCheckerOption>
            </se:WpfHtmlEditor.SpellCheckOptions>
        </se:WpfHtmlEditor>

    </Grid>
</Window>
