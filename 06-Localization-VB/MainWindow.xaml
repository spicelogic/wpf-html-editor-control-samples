<Window x:Class="LocalizationVB.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:se="clr-namespace:SpiceLogic.HtmlEditor.WPF;assembly=SpiceLogic.HtmlEditor.WPF"
        Title="WPF HTML editor control - localization (VB.NET)" Height="650" Width="1100">
    <DockPanel>
        <!-- Language selector panel -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="10,10,10,5">
            <TextBlock Text="Editor language:" VerticalAlignment="Center"
                       FontSize="14" Margin="0,0,10,0" />
            <ComboBox x:Name="LanguageCombo" Width="200" FontSize="14"
                      SelectionChanged="LanguageCombo_SelectionChanged" />
            <TextBlock x:Name="CurrentLanguageLabel" Text="Current: English (US)"
                       VerticalAlignment="Center" FontSize="14" FontStyle="Italic"
                       Foreground="DarkBlue" Margin="20,0,0,0" />
            <TextBlock Text="Spell check language:" VerticalAlignment="Center"
                       FontSize="14" Margin="20,0,10,0" />
            <ComboBox x:Name="SpellCheckCombo" Width="200" FontSize="14"
                      SelectionChanged="SpellCheckCombo_SelectionChanged" />
            <CheckBox x:Name="JsonOverrideCheckBox" Content="Enable JSON override (Polish)"
                      VerticalAlignment="Center" FontSize="14" Margin="20,0,0,0"
                      Checked="JsonOverrideCheckBox_Changed" Unchecked="JsonOverrideCheckBox_Changed" />
        </StackPanel>

        <!-- HTML Editor -->
        <se:WpfHtmlEditor x:Name="Editor" />
    </DockPanel>
</Window>
